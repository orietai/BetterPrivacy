{
  "compilerOptions": {
    "target": "ES2021",
    "lib": ["ES2021", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "jsx": "react",
    "jsxFactory": "BdApi.React.createElement",
    "jsxFragmentFactory": "BdApi.React.Fragment",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": []
  },
  "include": ["src", "tests"]
}
